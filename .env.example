# Salin file ini ke .env.local lalu sesuaikan nilainya.
# Hanya variabel berawalan VITE_ yang terbaca oleh frontend.

VITE_APP_NAME=Gopa Gym
VITE_GYM_ADDRESS=Jl. Bypass Ngurah Rai No.88, Karangasem
VITE_GYM_EMAIL=hello@gopagym.id
VITE_GYM_PHONE=+62 812 3456 7890
VITE_GYM_HOURS=06.00 - 22.00 WIB

# Batas ukuran foto profil anggota (KB)
VITE_MAX_PHOTO_KB=500

# Tampilkan akun demo di halaman login (set false untuk produksi)
VITE_SHOW_DEMO_ACCOUNTS=true
